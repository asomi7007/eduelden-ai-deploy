#!/bin/bash
# ============================================================
# Azure AI Foundry Vibe-Coding Lab — Configuration Template
# ============================================================
# Copy this file to config.env and fill in your values:
#   cp config.env.template config.env
#
# This is the SINGLE SOURCE OF TRUTH for all deployment parameters.
# All scripts in scripts/ source this file automatically.
# ============================================================

# --- Organization ---
ORG_NAME="YourOrg"                          # Organization display name (for APIM publisher)
ADMIN_EMAIL="admin@yourdomain.com"          # Admin email (for APIM publisher, budget alerts)
STUDENT_DOMAIN="yourdomain.com"             # Student email domain (e.g., 01@yourdomain.com)
STUDENT_COUNT=50                            # Number of students (01 to N)

# --- Azure Subscription ---
AZURE_SUBSCRIPTION_ID=""                    # az account show --query id -o tsv
AZURE_TENANT_ID=""                          # az account show --query tenantId -o tsv

# --- Naming Convention ---
# All Azure resources are named using PROJECT_NAME as a base.
# Change this ONE value to customize all resource names.
PROJECT_NAME="myproject"                    # e.g., "eduelden", "aiclass2026"

# Derived names (change only if you need different naming):
RESOURCE_GROUP="rg-${PROJECT_NAME}"
AI_RESOURCE_NAME="${PROJECT_NAME}-ai-resource"
AI_PROJECT_NAME="${PROJECT_NAME}-ai"
APIM_NAME="apim-${PROJECT_NAME}-ai"
SWA_NAME="swa-${PROJECT_NAME}-onboard"
ACS_NAME="acs-${PROJECT_NAME}-email"
ACS_EMAIL_SVC="acs-${PROJECT_NAME}-email-svc"
BUDGET_NAME="${PROJECT_NAME}-ai-budget"
SECURITY_GROUP="AI-Class-Students-${PROJECT_NAME}"
SERVICE_PRINCIPAL="github-actions-${PROJECT_NAME}"

# --- Regions ---
RG_REGION="koreacentral"                    # Resource group region
AI_REGION="eastus2"                         # AI Foundry region (must support target models)
APIM_REGION="eastus2"                       # APIM region (same as AI for low latency)
SWA_REGION="eastus2"                        # SWA region

# --- Budget ---
BUDGET_AMOUNT=800                           # Monthly budget in USD
BUDGET_ALERT_THRESHOLDS="50,80,95"          # Alert at these percentages

# --- Models ---
GPT_MINI_DEPLOYMENT="gpt-54-mini"           # Deployment name for fast model
GPT_MINI_MODEL="gpt-5.4-mini"              # Model catalog name
GPT_MINI_TPM=100                            # Tokens per minute (K)

GPT_FULL_DEPLOYMENT="gpt-55"               # Deployment name for quality model
GPT_FULL_MODEL="gpt-5.5"                   # Model catalog name
GPT_FULL_TPM=50                             # Tokens per minute (K)

DEEPSEEK_MODEL="DeepSeek-V4-Flash"          # Model catalog name
DEEPSEEK_DEPLOYMENT_1="deepseek-v4-flash-1" # Instance 1
DEEPSEEK_DEPLOYMENT_2="deepseek-v4-flash-2" # Instance 2

# --- Rate Limits ---
RATE_LIMIT_PER_MINUTE=10                    # Requests per minute per student
RATE_LIMIT_PER_DAY=200                      # Requests per day per student

# --- GitHub ---
GITHUB_OWNER=""                             # GitHub username or org
GITHUB_REPO=""                              # Repository name (e.g., "eduelden-ai-deploy")

# --- Class ---
CLASS_PASSCODE=""                           # Student onboarding passcode
ADMIN_PASSWORD=""                           # Admin dashboard password

# --- ACS Email (filled after Phase 5) ---
ACS_SENDER_ADDRESS=""                       # e.g., donotreply@{guid}.azurecomm.net
